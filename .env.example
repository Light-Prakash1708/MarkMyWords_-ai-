# ---- MarkMyWords configuration ----
# Copy to .env.local (npm run setup does this for you).

# AI provider. Without a key the app runs the rule-based DEMO evaluator and manual transcription.
ANTHROPIC_API_KEY=
# MMW_PROVIDER=anthropic          # anthropic | heuristic   (default: anthropic if a key is set)
# MMW_OCR_PROVIDER=anthropic      # anthropic | manual | mock (mock = tests only)
MMW_JUDGE_MODEL=claude-sonnet-5-5
MMW_FAST_MODEL=claude-haiku-5-5
MMW_VISION_MODEL=claude-sonnet-5-5
MMW_EVAL_SAMPLES=3

# Accounts with these emails become admins (review desk).
MMW_ADMIN_EMAILS=

# Secret used to sign short-lived upload URLs. `npm run setup` generates one. If unset in
# production, a random secret is generated once and stored in the database.
MMW_SIGNING_SECRET=change-me

# Storage. Locally a SQLite file is used. On Vercel (or any serverless host) connect a hosted
# libSQL database — e.g. add the Turso integration from the Vercel Marketplace, which sets these:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
MMW_DB_PATH=./data/markmywords.db

# Cost controls (INR). Prices are PLACEHOLDERS — set them from your provider's current price list.
MMW_DAILY_SPEND_CAP_INR=500
MMW_FREE_EVALS_PER_DAY=10
MMW_OCR_PAGES_PER_DAY=30
MMW_PRICE_INPUT_PER_MTOK_INR=300
MMW_PRICE_OUTPUT_PER_MTOK_INR=1500

# Learning loop
MMW_RETEST_DELAY_HOURS=48
MMW_EXEMPLAR_WAIT_MINUTES=10

# Demo mode shows questions still pending expert review (with a badge). Set false in production
# once reviewers have approved questions.
MMW_DEMO_MODE=true

# Optional malware scanning of uploads via clamd
# MMW_CLAMAV_HOST=127.0.0.1
# MMW_CLAMAV_PORT=3310

# Only for local http testing of a production build (cookies are Secure in production otherwise)
# MMW_INSECURE_COOKIES=true
